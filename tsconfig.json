{
  "compileOnSave": true,
  "include": [
    "src"
  ],
  "exclude": [
    ".tmp/*",
    "./.tmp/*",
    "node_modules"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "commonjs",
    "noImplicitReturns": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "jsx": "react"
  }
}